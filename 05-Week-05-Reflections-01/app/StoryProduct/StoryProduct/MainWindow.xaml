<Window x:Class="StoryProduct.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoryProduct"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="24">
            <TextBlock Text="My story checklist" FontSize="26" />
            <Label Content="_Name" Target="{Binding ElementName=NameInput}" />
            <TextBox x:Name="NameInput" />
            <Button Content="Build my checklist" Click="Build_Click"
            Margin="0,16,0,12" Padding="12" />
            <TextBlock x:Name="ResultText" Text="Ready."
               TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
